{
  "name": "@cianfrani/armor",
  "version": "0.0.0",
  "bin": {
    "armor": "./bin/armor"
  },
  "files": [
    "agents",
    "commands",
    "skills",
    "extensions",
    "bin",
    "scripts"
  ],
  "type": "module",
  "exports": {
    "./agents/*": "./agents/*",
    "./commands/*": "./commands/*",
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "link-config": "./scripts/link-config.sh",
    "check": "tsc --noEmit",
    "lint": "oxlint --tsconfig tsconfig.json --type-aware extensions/",
    "lint:fix": "oxlint --tsconfig tsconfig.json --type-aware --fix extensions/",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.2"
  }
}
